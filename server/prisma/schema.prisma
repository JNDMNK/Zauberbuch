// Zauberbuch – Prisma-Schema (SQLite)
// Hinweis: SQLite kennt in Prisma keine Listen; Enums werden als String gespeichert und
// über die gemeinsamen zod-Schemas (shared/src/enums.ts) validiert.

generator client {
  provider      = "prisma-client-js"
  // "native" genügt: Der Client wird im Docker-Build auf der jeweiligen Zielplattform (amd64/arm64, musl) erzeugt
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String            @id @default(cuid())
  username                String            @unique
  email                   String?           @unique
  passwordHash            String
  role                    String            @default("user") // "admin" | "user"
  language                String            @default("de") // "de" | "en"
  tokenVersion            Int               @default(0) // erhöht sich bei Passwortänderung -> alte JWTs ungültig
  canEditSpells           Boolean           @default(false) // Zusatzrecht: Zauber anlegen/bearbeiten/duplizieren (ohne Löschen)
  combatAsPlayer          Boolean           @default(false) // Admin: Kampfhilfe im Spielermodus (serverseitig, damit DMs beim Ausschalten benachrichtigt werden)
  /**
   * Geschichten-Ansicht: aktive Geschichte (null = Allgemein)
   */
  activeStoryId           String?
  activeStory             Story?            @relation("ActiveStory", fields: [activeStoryId], references: [id], onDelete: SetNull)
  /**
   * Profilbild: Zeitpunkt der letzten Änderung (null = kein Bild); das Bild selbst liegt in UserAvatar
   */
  avatarUpdatedAt         DateTime?
  avatar                  UserAvatar?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  favorites               Favorite[]
  characters              Character[]
  storyMemberships        StoryMember[]
  boardPosts              BoardPost[]       @relation("BoardPostAuthor")
  boardPostsEdited        BoardPost[]       @relation("BoardPostEditor")
  boardPostsDeleted       BoardPost[]       @relation("BoardPostDeleter")
  boardComments           BoardComment[]
  boardReads              BoardRead[]
  boardReactions          BoardReaction[]
  notifications           Notification[]
  chatSent                ChatMessage[]     @relation("ChatSender")
  chatReceived            ChatMessage[]     @relation("ChatRecipient")
  chatGroupsCreated       ChatGroup[]       @relation("ChatGroupCreator")
  chatGroups              ChatGroupMember[]
  characterEdits          CharacterEditor[]
  monsterTemplatesCreated MonsterTemplate[] @relation("MonsterTemplateCreator")
  monsterTemplatesUpdated MonsterTemplate[] @relation("MonsterTemplateUpdater")
  bestiaryCreated         BestiaryEntry[]   @relation("BestiaryCreator")
  bestiaryUpdated         BestiaryEntry[]   @relation("BestiaryUpdater")
}

model Spell {
  id            String             @id @default(cuid())
  slug          String             @unique
  level         Int // 0 = Zaubertrick, 1-9
  school        String // abjuration | conjuration | divination | evocation | illusion | necromancy | transmutation | enchantment
  castingTime   String // action | bonus_action | reaction | longer
  range         String
  verbal        Boolean            @default(false)
  somatic       Boolean            @default(false)
  material      Boolean            @default(false)
  concentration Boolean            @default(false)
  ritual        Boolean            @default(false)
  duration      String
  /**
   * Zusätzliche Zuordnung zu eigenen Wiki-Klassen (JSON-Liste von Wiki-Eintrags-IDs)
   */
  wikiClasses   String             @default("")
  source        String             @default("Homebrew")
  isHomebrew    Boolean            @default(false)
  damageDice    String? // Würfelausdruck, z. B. "8d6", "1d4+mod"
  damageType    String? // acid | bludgeoning | cold | fire | force | lightning | necrotic | piercing | poison | psychic | radiant | slashing | thunder | healing
  // Denormalisierte Hilfsfelder für sprachübergreifende Suche und Sortierung
  searchText    String             @default("")
  sortNameDe    String             @default("")
  sortNameEn    String             @default("")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  translations  SpellTranslation[]
  classes       SpellClassLink[]
  favorites     Favorite[]

  @@index([level])
  @@index([school])
  @@index([castingTime])
  @@index([damageType])
  @@index([sortNameDe])
  @@index([sortNameEn])
}

model SpellTranslation {
  id                  String  @id @default(cuid())
  spellId             String
  locale              String // "de" | "en"
  name                String
  materialDescription String?
  castingTimeText     String?
  rangeText           String?
  durationText        String?
  description         String
  higherLevels        String?
  spell               Spell   @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([spellId, locale])
  @@index([locale])
}

model SpellClassLink {
  spellId   String
  className String // bard | druid | warlock | cleric | wizard | paladin | ranger | sorcerer | artificer
  spell     Spell  @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@id([spellId, className])
  @@index([className])
}

model Favorite {
  userId    String
  spellId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spell     Spell    @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@id([userId, spellId])
  @@index([spellId])
}

/// Charakterbogen – der eigentliche Bogen steht als validiertes JSON in `data`
model Character {
  id             String            @id @default(cuid())
  userId         String
  name           String            @default("")
  classLevel     String            @default("")
  race           String            @default("")
  level          Int               @default(1)
  data           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  combatants     Combatant[]
  /**
   * Zuordnung zu einer Geschichte (Besitzer wird dabei Mitspieler); grenzt die Auswahl im Kampf ein
   */
  storyId        String?
  story          Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  /**
   * Vom Dungeon Master freigegebener Meilenstein-Aufstieg: Stufe, auf die ohne genug EP aufgestiegen werden darf
   */
  milestoneLevel Int?
  /**
   * Weitere Benutzer, die den Bogen bearbeiten dürfen
   */
  editors        CharacterEditor[]
  /**
   * Persönliche Notizen zum Charakter (privat, einzeln für den DM freigebbar)
   */
  notes          CharacterNote[]
  chatMessages   ChatMessage[]
  magicItems     MagicItemHolder[]

  @@index([userId])
}

// ---- Infotafel ----

/**
 * Geschichte (Story/Kampagne) mit eigener Infotafel; Admin und Dungeon Master verwalten sie.
 */
model Story {
  id           String          @id @default(cuid())
  name         String
  description  String          @default("")
  archived     Boolean         @default(false)
  /**
   * Lebensstile mit täglichen Kosten (JSON [{ name, cost }]); leer = Standardwerte
   */
  lifestyles   String          @default("")
  /**
   * Auswahllisten für „Übung und Sprachen“ (JSON string[]); leer = Standardwerte
   */
  languages    String          @default("")
  /**
   * Götter der Geschichte (JSON string[]); leer = alle Götter aus dem Wiki
   */
  gods         String          @default("")
  tools        String          @default("")
  /**
   * Erlaubte Quellen (JSON string[] mit Quellen-IDs und „homebrew“); leer = alle Quellen
   */
  sources      String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      StoryMember[]
  posts        BoardPost[]
  reads        BoardRead[]
  encounters   Encounter[]
  bestiary     BestiaryEntry[]
  characters   Character[]
  activeFor    User[]          @relation("ActiveStory")
  catalogItems CatalogItem[]
  dmNotes      DmNote[]
  chatMessages ChatMessage[]
  chatGroups   ChatGroup[]
}

/**
 * Mitspieler einer Geschichte (Admin und Dungeon Master sehen alle Geschichten)
 */
model StoryMember {
  storyId         String
  userId          String
  /**
   * Rolle in dieser Geschichte: player | dm (steuert Infotafel und Kampf)
   */
  role            String   @default("player")
  /**
   * Chat: zuletzt gewählter Charakter für „Schreiben als“ (null = als Benutzer)
   */
  chatCharacterId String?
  createdAt       DateTime @default(now())
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

model BoardPost {
  id          String          @id @default(cuid())
  storyId     String
  story       Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /**
   * null = Ersteller wurde gelöscht (Beitrag bleibt erhalten)
   */
  authorId    String?
  author      User?           @relation("BoardPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title       String          @default("")
  body        String
  category    String          @default("general") // general | dates | places | npcs | quests | items | lore
  searchText  String          @default("")
  pinned      Boolean         @default(false)
  pinnedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  editedAt    DateTime?
  editedById  String?
  editedBy    User?           @relation("BoardPostEditor", fields: [editedById], references: [id], onDelete: SetNull)
  /**
   * Papierkorb: gelöschte Beiträge kann der Admin 90 Tage lang wiederherstellen
   */
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?           @relation("BoardPostDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  comments    BoardComment[]
  reactions   BoardReaction[]

  @@index([storyId, deletedAt, createdAt])
  @@index([deletedAt])
}

/// Gefällt mir / Gefällt mir nicht – je Benutzer und Beitrag höchstens eine Reaktion
model BoardReaction {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // 1 = Like, -1 = Dislike
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model BoardComment {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([postId, createdAt])
}

/**
 * Zuletzt gelesen – für den Ungelesen-Zähler
 */
model BoardRead {
  userId     String
  storyId    String
  lastReadAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([storyId])
}

// ---- Kampfhilfe ----

/**
 * Kampf innerhalb einer Geschichte; verwaltet von Admin/Dungeon Master, Mitspieler sehen ihn nur lesend
 */
model Encounter {
  id              String      @id @default(cuid())
  storyId         String
  story           Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name            String
  round           Int         @default(1)
  /**
   * Teilnehmer, der gerade am Zug ist
   */
  turnCombatantId String?
  ended           Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  combatants      Combatant[]

  @@index([storyId])
}

/**
 * Teilnehmer: Spielercharakter (Werte live aus dem Charakterbogen, nur lesend) oder Monster (vom DM gepflegt)
 */
model Combatant {
  id          String           @id @default(cuid())
  encounterId String
  encounter   Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  kind        String // character | monster | ally (verbündeter NSC)
  characterId String?
  character   Character?       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String           @default("")
  initiative  Int?
  ac          Int?
  hpCurrent   Int              @default(0)
  hpMax       Int              @default(0)
  /**
   * Monster: RK und LP für Spieler verbergen (Spieler sehen nur einen groben Zustand)
   */
  hideStats   Boolean          @default(true)
  /**
   * JSON-Array der Zustände
   */
  conditions  String           @default("[]")
  /**
   * Nur für DM/Admin sichtbar (aus der Monster-Datenbank übernommen)
   */
  attack      String           @default("")
  /**
   * Schaden wie bei Zaubern: Würfelausdruck (z. B. "1d6+2") und Schadensart
   */
  damageDice  String?
  damageType  String?
  description String           @default("")
  /**
   * Vorlage aus der DM-Monster-Datenbank, aus der das Monster stammt (Werteblock im Kampf öffnen)
   */
  templateId  String?
  template    MonsterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([encounterId])
  @@index([characterId])
}

/**
 * Benachrichtigungen in der App (Glocke in der Kopfzeile)
 */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // z. B. admin_player_mode_off
  /**
   * JSON mit Platzhaltern für den Text (z. B. { "admin": "jan" })
   */
  data      String    @default("{}")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

// ---- Monster-Datenbanken ----

/**
 * Monster-Datenbank des DM (gemeinsam für alle Dungeon Master und Admins); Vorlagen für Kämpfe
 */
model MonsterTemplate {
  id          String   @id @default(cuid())
  name        String
  ac          Int?
  hp          Int      @default(0)
  attack      String   @default("")
  /**
   * Schaden wie bei Zaubern: Würfelausdruck (z. B. "1d6+2") und Schadensart
   */
  damageDice  String?
  damageType  String?
  description String   @default("")
  /**
   * Vollständiger Werteblock als JSON (Größe, Typ, Attribute, Merkmale, Aktionen …)
   */
  stats       String   @default("{}")
  createdById String?
  createdBy   User?    @relation("MonsterTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("MonsterTemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  combatants Combatant[]

  @@index([name])
}

/**
 * Monster-Datenbank der Spieler je Geschichte (gemeinsames Notizbuch der Mitspieler; DM/Admin nur lesend)
 */
model BestiaryEntry {
  id          String   @id @default(cuid())
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name        String
  ac          Int?
  /**
   * LP als Text: Zahl oder Bereich, z. B. "58" oder "10-15" (Spieler kennen oft nur eine Schätzung)
   */
  hp          String?
  attack      String   @default("")
  /**
   * Schaden wie bei Zaubern: Würfelausdruck (z. B. "1d6+2") und Schadensart
   */
  damageDice  String?
  damageType  String?
  description String   @default("")
  /**
   * Vollständiger Werteblock als JSON (Größe, Typ, Attribute, Merkmale, Aktionen …)
   */
  stats       String   @default("{}")
  createdById String?
  createdBy   User?    @relation("BestiaryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("BestiaryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storyId, name])
}

/**
 * Mitbearbeiter eines Charakterbogens (dürfen Werte ändern, aber nicht löschen/duplizieren/Einstellungen ändern)
 */
model CharacterEditor {
  characterId String
  userId      String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([characterId, userId])
  @@index([userId])
}

// ---- Magische Gegenstände ----

/**
 * Magischer Gegenstand einer Geschichte; verwaltet von Admin, Moderator und den Dungeon Mastern der Geschichte
 */
/**
 * Magische Gegenstände: eine allgemeine Datenbank für alle Geschichten (Admin, Moderator und alle Dungeon Master).
 * Besitzer werden je Geschichte vergeben (Charakterbögen der Geschichte).
 */
model MagicItem {
  id          String            @id @default(cuid())
  name        String
  description String            @default("")
  /**
   * Gewicht in lb – zählt zur Last der Charaktere, die den Gegenstand besitzen
   */
  weight      Float             @default(0)
  /**
   * Wert als Freitext, z. B. „200 GM“
   */
  value       String            @default("")
  /**
   * Einstimmung benötigt – nur dann im Charakterbogen bei „Einstimmung“ wählbar
   */
  attunement  Boolean           @default(false)
  /**
   * Quelle (Buch)
   */
  sourceId    String?
  source      Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  holders     MagicItemHolder[]

  @@index([name])
}

/**
 * Welche Charakterbögen den Gegenstand besitzen (mehrere möglich)
 */
model MagicItemHolder {
  itemId      String
  characterId String
  createdAt   DateTime  @default(now())
  item        MagicItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([itemId, characterId])
  @@index([characterId])
}

// ---- Gegenstände (Rüstung, Waffen, Ausrüstung) ----

/**
 * Gegenstands-Katalog. storyId = null: Standard-Datenbank (Admin/Moderator).
 * Einträge einer Geschichte: eigene (baseId = null) oder Anpassung/Ausblendung eines Standard-Eintrags (baseId gesetzt).
 * Geschichten erben die Standard-Datenbank live; Anpassungen überdecken den Standard-Eintrag.
 */
model CatalogItem {
  id          String        @id @default(cuid())
  storyId     String?
  story       Story?        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  baseId      String?
  base        CatalogItem?  @relation("CatalogOverride", fields: [baseId], references: [id], onDelete: Cascade)
  overrides   CatalogItem[] @relation("CatalogOverride")
  /**
   * Standard-Eintrag in dieser Geschichte ausgeblendet
   */
  hidden      Boolean       @default(false)
  category    String // armor | weapon | gear
  name        String
  description String        @default("")
  weight      Float         @default(0)
  /**
   * Rüstungsklasse als Text, z. B. "11 + GES" oder "+2"
   */
  /// Wert als Freitext, z. B. „5 GM“
  value       String        @default("")
  ac          String        @default("")
  /// Rüstung: benötigter Stärkewert (leer = keine Anforderung)
  strength    Int?
  damageDice  String?
  damageType  String?
  /// Ausrüstung (Werkzeug): artisan | gaming | instrument | other
  toolType    String?
  sourceId    String?
  source      Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([storyId, baseId])
  @@index([storyId, category])
}

/// DM-Notizen einer Geschichte (nur für die Dungeon Master der Geschichte): sortierbare Abschnitte mit Markdown-Text
model DmNote {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  position  Int      @default(0)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId, position])
}

/// Wiki (Völker und Klassen nach SRD): für alle lesbar, bearbeitbar von Admin und Moderator
model WikiEntry {
  id          String   @id @default(cuid())
  kind        String // race | class
  name        String
  summary     String   @default("")
  description String   @default("")
  /// Detailfelder je Rubrik als JSON
  data        String   @default("{}")
  sourceId    String?
  source      Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, name])
}

/// Quellen (Bücher), app-weit auswählbar (Wiki, Gegenstände, Vorschläge bei Zaubern); Admin und Moderator pflegen sie
model Source {
  id           String        @id @default(cuid())
  name         String        @unique
  /// Kürzel, z. B. „SHB“
  abbreviation String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  wikiEntries  WikiEntry[]
  catalogItems CatalogItem[]
  magicItems   MagicItem[]
}

/// Persönliche Notiz zu einem Charakter: sichtbar für Besitzer und Mitbearbeiter, mit sharedWithDm auch für den DM der Geschichte
model CharacterNote {
  id           String    @id @default(cuid())
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title        String    @default("")
  body         String    @default("")
  category     String    @default("general")
  pinned       Boolean   @default(false)
  sharedWithDm Boolean   @default(false)
  /// Name des Verfassers zum Zeitpunkt des Schreibens
  authorName   String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([characterId])
}

/// Private Chat-Nachricht zwischen zwei Mitgliedern einer Geschichte (Spieler ↔ DM, Spieler ↔ Spieler)
model ChatMessage {
  id            String     @id @default(cuid())
  storyId       String
  story         Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User       @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  /// Zweiergespräch: Empfänger; Gruppennachricht: null
  recipientId   String?
  recipient     User?      @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Gruppennachricht: Gruppe
  groupId       String?
  group         ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// „Als Charakter sprechen“ (Name zum Zeitpunkt des Schreibens)
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterName String     @default("")
  /// text | dice
  kind          String     @default("text")
  body          String     @default("")
  /// Würfelwurf als JSON (bei kind = dice)
  dice          String     @default("")
  edited        Boolean    @default(false)
  deleted       Boolean    @default(false)
  readAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([storyId, senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([groupId, createdAt])
  @@index([updatedAt])
}

/// Chatgruppe innerhalb einer Geschichte – sichtbar nur für ihre Mitglieder
model ChatGroup {
  id             String            @id @default(cuid())
  storyId        String
  story          Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name           String
  createdById    String?
  createdBy      User?             @relation("ChatGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Gruppenbild: Zeitpunkt der letzten Änderung (null = kein Bild); das Bild liegt in ChatGroupImage
  imageUpdatedAt DateTime?
  image          ChatGroupImage?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  members        ChatGroupMember[]
  messages       ChatMessage[]

  @@index([storyId])
}

model ChatGroupMember {
  groupId    String
  group      ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// bis hierhin gelesen (Ungelesen-Zähler)
  lastReadAt DateTime  @default(now())
  joinedAt   DateTime  @default(now())
  /// Gruppenadmin (vom Ersteller ernannt): Name, Bild und Mitglieder ändern
  isAdmin    Boolean   @default(false)

  @@id([groupId, userId])
  @@index([userId])
}

/// Profilbild eines Benutzers (Data-URL, im Browser verkleinert) – getrennt, damit es nicht bei jeder Anfrage mitgeladen wird
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  updatedAt DateTime @updatedAt
}

/// Gruppenbild (Data-URL, im Browser verkleinert)
model ChatGroupImage {
  groupId   String    @id
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  data      String
  updatedAt DateTime  @updatedAt
}
