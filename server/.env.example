# Lokale Entwicklung ohne Docker: nach server/.env kopieren
# Pfad relativ zu server/prisma/schema.prisma -> <repo>/data/zauberbuch.db
DATABASE_URL="file:../../data/zauberbuch.db"
# relativ zu server/
DATA_DIR=../data
PORT=8080
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ALLOW_REGISTRATION=true
DEFAULT_LANGUAGE=de
SEED_EXAMPLES=true
LOG_TO_FILE=false
TZ=Europe/Berlin
