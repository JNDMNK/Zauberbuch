# Variablen für docker compose (nach .env kopieren und anpassen)

# Fertiges Image statt lokalem Build verwenden:
# ZAUBERBUCH_IMAGE=ghcr.io/jndmnk/zauberbuch:latest

HOST_PORT=8080
DATA_PATH=/mnt/user/appdata/zauberbuch
PUID=99
PGID=100
UMASK=022
TZ=Europe/Berlin

ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern-123
ALLOW_REGISTRATION=true
DEFAULT_LANGUAGE=de
SEED_EXAMPLES=true
# leer = wird automatisch erzeugt und in /data/jwt_secret gespeichert
JWT_SECRET=
